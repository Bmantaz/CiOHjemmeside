@using CiOHjemmeside.Data.Models
@using CiOHjemmeside.Data.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IEpkAssetService EpkAssetService
@inject IEpkFileUrlService EpkFileUrls

@*
    Genbrugelig EPK-sektion. Viser altid indholdet for besøgende,
    og tilføjer opret/rediger/slet-kontroller når brugeren er Admin.
    Styles ligger i wwwroot/epk.css.
*@

<AuthorizeView Roles="Admin" Context="statusCtx">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="epk-status epk-ok">@message</p>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="epk-status epk-error">@error</p>
    }
</AuthorizeView>

@if (assets is null)
{
    <p class="epk-empty">Loading...</p>
}
else if (!assets.Any())
{
    <p class="epk-empty">Nothing here yet.</p>
}
else if (Gallery)
{
    <div class="epk-gallery">
        @foreach (var asset in assets)
        {
            var bg = GetBackground(asset);
            <article class="epk-card">
                <div class="epk-stage epk-bg-@bg">
                    @if (asset.HasThumbnail)
                    {
                        <img src="@EpkFileUrls.ThumbUrl(asset.Id)" alt="@asset.Title" loading="lazy" />
                    }
                    else
                    {
                        <span class="epk-stage-fallback">@FileKind(asset)</span>
                    }

                    <div class="epk-swatches" role="group" aria-label="Preview background">
                        @foreach (var option in BackgroundOptions)
                        {
                            <button type="button"
                                    class="epk-swatch epk-bg-@option.Key @(bg == option.Key ? "active" : "")"
                                    title="@option.Label background"
                                    aria-label="@option.Label background"
                                    aria-pressed="@(bg == option.Key ? "true" : "false")"
                                    @onclick="() => backgrounds[asset.Id] = option.Key"></button>
                        }
                    </div>
                </div>

                <div class="epk-card-body">
                    <h2 class="epk-card-title">@asset.Title</h2>
                    <span class="epk-row-meta">@FileKind(asset) · @FormatSize(asset.FileSize)</span>

                    <div class="epk-card-actions">
                        <a class="epk-btn epk-btn-outline" href="@FileUrl(asset)" target="_blank" rel="noopener noreferrer">
                            View <span class="epk-arrow">&#8599;</span>
                        </a>
                        <a class="epk-btn epk-btn-primary" href="@FileUrl(asset)" download="@asset.FileName">Download</a>
                    </div>

                    <AuthorizeView Roles="Admin" Context="adminCtx">
                        @AdminRow(asset)
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="epk-frame">
        @foreach (var (asset, index) in assets.Select((a, i) => (a, i)))
        {
            <div class="epk-row">
                <span class="epk-row-index">@((index + 1).ToString("00"))</span>
                <div>
                    <span class="epk-row-title">@asset.Title</span>
                    <span class="epk-row-meta">@FileKind(asset) · @FormatSize(asset.FileSize)</span>
                </div>
                <div class="epk-row-actions">
                    <a class="epk-btn epk-btn-outline" href="@FileUrl(asset)" target="_blank" rel="noopener noreferrer">
                        View <span class="epk-arrow">&#8599;</span>
                    </a>
                    <a class="epk-btn epk-btn-primary" href="@FileUrl(asset)" download="@asset.FileName">Download</a>
                </div>

                <AuthorizeView Roles="Admin" Context="adminCtx">
                    <div class="epk-row-admin">@AdminRow(asset)</div>
                </AuthorizeView>
            </div>
        }
    </div>
}

<AuthorizeView Roles="Admin" Context="uploadCtx">
    <section class="epk-upload">
        <h2>Tilføj nyt indhold <span class="epk-badge">ADMIN</span></h2>

        <div class="epk-form">
            <input class="epk-input" @bind="newTitle" placeholder="Titel" aria-label="Titel" />
            <InputFile OnChange="OnNewFileSelected" accept="@AcceptFilter" />
            <button class="epk-btn epk-btn-primary" disabled="@(isBusy || newFile is null)" @onclick="UploadNew">
                @(isBusy ? "Uploader..." : "Upload")
            </button>
        </div>
        @if (newFile is not null)
        {
            <p class="epk-admin-meta">Valgt: @newFile.Name (@FormatSize(newFile.Size))</p>
        }
    </section>
</AuthorizeView>

@code {
    /// <summary>
    /// Admin-kontroller pr. element: omdøb, udskift fil, ændr rækkefølge og slet.
    /// Vises kun inde i en AuthorizeView med rollen Admin.
    /// </summary>
    private RenderFragment AdminRow(EpkAsset asset) => __builder =>
    {
        <div class="epk-admin">
            @if (editingId == asset.Id)
            {
                <input class="epk-admin-input" @bind="editingTitle" placeholder="Titel" />
                <button class="epk-admin-btn" @onclick="() => SaveTitle(asset)">Gem</button>
                <button class="epk-admin-btn" @onclick="CancelEdit">Annuller</button>
            }
            else if (confirmDeleteId == asset.Id)
            {
                <span class="epk-admin-note">Slet "@asset.Title"?</span>
                <button class="epk-admin-btn danger" @onclick="() => Delete(asset)">Ja, slet</button>
                <button class="epk-admin-btn" @onclick="() => confirmDeleteId = null">Fortryd</button>
            }
            else
            {
                <button class="epk-admin-btn" @onclick="() => StartEdit(asset)">Omdøb</button>
                <button class="epk-admin-btn" disabled="@isBusy" @onclick="() => Move(asset, -1)" title="Flyt op">&#8593;</button>
                <button class="epk-admin-btn" disabled="@isBusy" @onclick="() => Move(asset, 1)" title="Flyt ned">&#8595;</button>
                <label class="epk-admin-btn">
                    Udskift fil
                    <InputFile OnChange="@(e => ReplaceFile(asset, e))" accept="@AcceptFilter" style="display:none" />
                </label>
                <button class="epk-admin-btn danger" @onclick="() => confirmDeleteId = asset.Id">Slet</button>
                <p class="epk-admin-meta">@asset.FileName</p>
            }
        </div>
    };

    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;

    /// <summary>Vis som billedgalleri med previews i stedet for en liste.</summary>
    [Parameter] public bool Gallery { get; set; }

    private const long MaxFileSize = 10 * 1024 * 1024;

    // Baggrunde man kan se et billede på. Især nyttigt for transparente logoer.
    private static readonly (string Key, string Label)[] BackgroundOptions =
    {
        ("dark", "Dark"),
        ("light", "Light"),
        ("red", "Red"),
        ("checker", "Transparent")
    };

    private List<EpkAsset>? assets;
    private readonly Dictionary<int, string> backgrounds = new();
    private IBrowserFile? newFile;
    private string newTitle = string.Empty;
    private string message = string.Empty;
    private string error = string.Empty;
    private bool isBusy;

    private int? editingId;
    private string editingTitle = string.Empty;
    private int? confirmDeleteId;

    private string AcceptFilter => Gallery ? "image/*" : ".pdf,image/*";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        assets = (await EpkAssetService.GetByCategoryAsync(Category)).ToList();
    }

    // Signeret link; virker kun fordi denne komponent altid ligger inde i en EpkGate.
    private string FileUrl(EpkAsset asset) => EpkFileUrls.FileUrl(asset.Id);

    /// <summary>
    /// Startbaggrund: sorte logoer vises på lys baggrund, alt andet på mørk,
    /// så intet logo "forsvinder". Besøgende kan selv skifte.
    /// </summary>
    private string GetBackground(EpkAsset asset)
    {
        if (backgrounds.TryGetValue(asset.Id, out var chosen))
        {
            return chosen;
        }

        var name = $"{asset.Title} {asset.FileName}";
        var isBlackArtwork = name.Contains("black", StringComparison.OrdinalIgnoreCase)
            || name.Contains("sort", StringComparison.OrdinalIgnoreCase);

        return isBlackArtwork ? "light" : "dark";
    }

    private static string FileKind(EpkAsset asset)
    {
        var extension = Path.GetExtension(asset.FileName).TrimStart('.').ToUpperInvariant();
        if (!string.IsNullOrEmpty(extension))
        {
            return extension == "JPEG" ? "JPG" : extension;
        }

        return asset.IsImage ? "Image" : "File";
    }

    private void OnNewFileSelected(InputFileChangeEventArgs e)
    {
        error = string.Empty;
        message = string.Empty;
        newFile = e.File;

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            newTitle = Path.GetFileNameWithoutExtension(e.File.Name);
        }
    }

    private async Task UploadNew()
    {
        if (newFile is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            error = "Angiv en titel.";
            return;
        }

        isBusy = true;
        error = string.Empty;
        message = string.Empty;

        try
        {
            var content = await ReadFileAsync(newFile);
            await EpkAssetService.AddAsync(Category, newTitle.Trim(), newFile.Name, ResolveContentType(newFile), content);

            newFile = null;
            newTitle = string.Empty;
            message = "Filen blev uploadet.";
            await ReloadAsync();
        }
        catch (IOException)
        {
            error = $"Filen er for stor. Maks {FormatSize(MaxFileSize)}.";
        }
        catch (Exception ex)
        {
            error = $"Upload fejlede: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ReplaceFile(EpkAsset asset, InputFileChangeEventArgs e)
    {
        isBusy = true;
        error = string.Empty;
        message = string.Empty;

        try
        {
            var content = await ReadFileAsync(e.File);
            await EpkAssetService.ReplaceFileAsync(asset.Id, e.File.Name, ResolveContentType(e.File), content);

            message = $"\"{asset.Title}\" blev opdateret.";
            await ReloadAsync();
        }
        catch (IOException)
        {
            error = $"Filen er for stor. Maks {FormatSize(MaxFileSize)}.";
        }
        catch (Exception ex)
        {
            error = $"Opdatering fejlede: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(EpkAsset asset)
    {
        editingId = asset.Id;
        editingTitle = asset.Title;
        confirmDeleteId = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        editingTitle = string.Empty;
    }

    private async Task SaveTitle(EpkAsset asset)
    {
        if (string.IsNullOrWhiteSpace(editingTitle))
        {
            error = "Titel må ikke være tom.";
            return;
        }

        await EpkAssetService.UpdateTitleAsync(asset.Id, editingTitle.Trim());
        editingId = null;
        message = "Titlen blev gemt.";
        await ReloadAsync();
    }

    private async Task Move(EpkAsset asset, int direction)
    {
        await EpkAssetService.MoveAsync(asset.Id, direction);
        await ReloadAsync();
    }

    private async Task Delete(EpkAsset asset)
    {
        await EpkAssetService.DeleteAsync(asset.Id);
        confirmDeleteId = null;
        message = $"\"{asset.Title}\" blev slettet.";
        await ReloadAsync();
    }

    private static async Task<byte[]> ReadFileAsync(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(MaxFileSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private static string ResolveContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType))
        {
            return file.ContentType;
        }

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".pdf" => "application/pdf",
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            _ => "application/octet-stream"
        };
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024.0 * 1024.0):0.#} MB";
        }

        return $"{bytes / 1024.0:0.#} KB";
    }
}
