@page "/users"
@layout Layout.InternalLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using System.Diagnostics
@inject IUserService UserService
@inject IConcertService ConcertService
@inject IProductService ProductService
@inject ICalendarEventService CalendarEventService
@inject NavigationManager NavManager

<link rel="stylesheet" href="Components/Pages/UserManagement.razor.css" />

<PageTitle>Brugerstyring</PageTitle>

<div class="admin-header">
    <h1>Brugerstyring</h1>
    <button class="btn btn-add" @onclick="ShowAddModal">
        <span class="bi bi-person-plus-fill-nav-menu"></span> Opret Ny Bruger
    </button>
</div>

<p>Admin-side til at oprette og redigere brugerroller.</p>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="status-message">@statusMessage</p>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="status-error">@errorMessage</p>
}

<table class="admin-table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Rolle</th>
            <th class="text-right">Handling</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in usersList)
        {
            <tr>
                <td data-label="Username">@user.Username</td>
                <td data-label="Rolle">
                    <span class="role-badge @user.Role.ToLower()">@user.Role</span>
                </td>
                <td data-label="Handling" class="text-right">
                    @if (confirmDeleteUserId == user.Id)
                    {
                        <span class="delete-confirm-text">Slet @user.Username?</span>
                        <button class="btn btn-delete" disabled="@isProcessingDelete" @onclick="() => DeleteUser(user)">Ja, slet</button>
                        <button class="btn btn-cancel" disabled="@isProcessingDelete" @onclick="() => confirmDeleteUserId = null">Fortryd</button>
                    }
                    else
                    {
                        <button class="btn btn-edit" @onclick="() => ShowEditModal(user)">Rediger Rolle</button>
                        <button class="btn btn-edit" @onclick="() => ShowPasswordModal(user)">Skift Password</button>
                        @if (user.Id != currentUserId)
                        {
                            <button class="btn btn-delete" @onclick="() => confirmDeleteUserId = user.Id">Slet</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


@if (isModalVisible)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3>@modalTitle</h3>
            <button class="btn-close-modal" @onclick="CloseModal">×</button>
        </div>

        <EditForm Model="currentUser" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            <div class="modal-body">

                <div class="form-group-modal">
                    <label>Username</label>
                    <InputText class="form-control-modal" @bind-Value="currentUser.Username" disabled="@(!isCreatingNewUser)" />
                    <ValidationMessage For="() => currentUser.Username" />
                </div>

                @if (isCreatingNewUser)
                {
                    <div class="form-group-modal">
                        <label>Password</label>
                        <InputText type="password" class="form-control-modal" @bind-Value="newPassword" />
                        <ValidationMessage For="() => newPassword" />
                    </div>
                }

                <div class="form-group-modal">
                    <label>Rolle</label>
                    <InputSelect class="form-control-modal" @bind-Value="currentUser.Role">
                        <option value="">Vælg rolle...</option>
                        <option value="Admin">Admin</option>
                        <option value="Member">Member</option>
                        <option value="Sales">Sales</option>
                    </InputSelect>
                    <ValidationMessage For="() => currentUser.Role" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" @onclick="CloseModal">Annuller</button>
                <button type="submit" class="btn btn-save" disabled="@isProcessingSave">
                    @if (isProcessingSave)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {

                        <span>Gem</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
}


@if (isPasswordModalVisible)
{
    <div class="modal-backdrop" @onclick="ClosePasswordModal"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3>Skift Password: @passwordUserName</h3>
            <button class="btn-close-modal" @onclick="ClosePasswordModal">×</button>
        </div>

        <div class="modal-body">
            <div class="form-group-modal">
                <label>Nyt password</label>
                <input type="password" class="form-control-modal" @bind="newPasswordValue" />
            </div>

            <div class="form-group-modal">
                <label>Bekræft password</label>
                <input type="password" class="form-control-modal" @bind="confirmPasswordValue" />
            </div>

            @if (!string.IsNullOrWhiteSpace(passwordError))
            {
                <p class="status-error">@passwordError</p>
            }

            <p class="password-hint">
                Mindst 8 tegn, et stort bogstav, et tal og et specialtegn.
            </p>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-cancel" @onclick="ClosePasswordModal">Annuller</button>
            <button type="button" class="btn btn-save" disabled="@isProcessingPassword" @onclick="HandlePasswordSave">
                @if (isProcessingPassword)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Gem password</span>
                }
            </button>
        </div>
    </div>
}


<div class="admin-section">
    <h2>Database Forbindelsestest</h2>
    <p>Kør en test af alle Dapper-services for at validere forbindelsen til databasen.</p>
    <button class="btn btn-edit" @onclick="RunDataTest" disabled="@isProcessingTest">
        @if (isProcessingTest)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span> Tester...</span>
        }
        else
        {
            <span>Kør Test</span>
        }
    </button>

    @if (testLog.Any())
    {
        <h3 class="mt-4">Testresultater:</h3>
        @foreach (var (status, error) in testLog)
        {
            <div class="mb-3">
                <pre class="@(string.IsNullOrEmpty(error) ? "text-success" : "text-danger")">@status</pre>
                @if (!string.IsNullOrEmpty(error))
                {
                    <pre class="text-danger small">@error</pre>
                }
            </div>
        }
    }
</div>


@code {
    // Fase 3: Hentes nu fra databasen
    private List<User> usersList = new();

    private bool isModalVisible = false;
    private bool isCreatingNewUser = false;
    private bool isProcessingSave = false;
    private string modalTitle = "Rediger Bruger";
    private User currentUser = new();
    private string newPassword = "";

    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;

    // Skift password
    private bool isPasswordModalVisible = false;
    private bool isProcessingPassword = false;
    private int passwordUserId;
    private string passwordUserName = string.Empty;
    private string newPasswordValue = string.Empty;
    private string confirmPasswordValue = string.Empty;
    private string passwordError = string.Empty;

    // Sletning
    private int? confirmDeleteUserId;
    private bool isProcessingDelete = false;

    // Den indloggede admin, saa man ikke kan slette sig selv.
    private int currentUserId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idClaim, out var parsedId))
            {
                currentUserId = parsedId;
            }
        }

        // Fase 3: Hent rigtige data fra databasen
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        usersList = (await UserService.GetAllAsync()).ToList();
    }

    private void ShowAddModal()
    {
        currentUser = new User();
        newPassword = "";
        isCreatingNewUser = true;
        modalTitle = "Opret Ny Bruger";
        isModalVisible = true;
    }

    private async Task ShowEditModal(User userToEdit)
    {
        // GetAllAsync() no longer returns the password hash (to avoid exposing it in list views),
        // so fetch the full user record by ID to preserve the existing hash on save.
        var fullUser = await UserService.GetByIdAsync(userToEdit.Id);
        if (fullUser == null)
        {
            return;
        }

        currentUser = new User
        {
            Id = fullUser.Id,
            Username = fullUser.Username,
            Role = fullUser.Role,
            PasswordHash = fullUser.PasswordHash // Vigtigt at bevare den gamle hash
        };
        newPassword = "";
        isCreatingNewUser = false;
        modalTitle = $"Rediger Rolle: {currentUser.Username}";
        isModalVisible = true;
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }

    private async Task ForcePasswordReset(User user)
    {
        await UserService.SetMustResetPasswordAsync(user.Id, true);
        await LoadUsers();
    }

    private void ShowPasswordModal(User user)
    {
        passwordUserId = user.Id;
        passwordUserName = user.Username;
        newPasswordValue = string.Empty;
        confirmPasswordValue = string.Empty;
        passwordError = string.Empty;
        statusMessage = string.Empty;
        errorMessage = string.Empty;
        confirmDeleteUserId = null;
        isPasswordModalVisible = true;
    }

    private void ClosePasswordModal()
    {
        isPasswordModalVisible = false;
    }

    private async Task HandlePasswordSave()
    {
        passwordError = string.Empty;

        if (string.IsNullOrWhiteSpace(newPasswordValue) || string.IsNullOrWhiteSpace(confirmPasswordValue))
        {
            passwordError = "Udfyld begge felter.";
            return;
        }

        if (newPasswordValue != confirmPasswordValue)
        {
            passwordError = "Passwords er ikke ens.";
            return;
        }

        if (!IsValidPassword(newPasswordValue))
        {
            passwordError = "Mindst 8 tegn, et stort bogstav, et tal og et specialtegn.";
            return;
        }

        isProcessingPassword = true;

        try
        {
            var user = await UserService.GetByIdAsync(passwordUserId);
            if (user == null)
            {
                passwordError = "Brugeren blev ikke fundet.";
                return;
            }

            user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPasswordValue);

            // Admin saetter et konkret password, saa brugeren skal ikke tvinges
            // gennem nulstillingsfloewet ved naeste login.
            user.MustResetPassword = false;

            await UserService.UpdateAsync(user);

            statusMessage = $"Password blev opdateret for {user.Username}.";
            isPasswordModalVisible = false;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            passwordError = $"Kunne ikke opdatere password: {ex.Message}";
        }
        finally
        {
            isProcessingPassword = false;
        }
    }

    private async Task DeleteUser(User user)
    {
        statusMessage = string.Empty;
        errorMessage = string.Empty;

        // Ekstra sikkerhed: en admin maa ikke slette sin egen konto.
        if (user.Id == currentUserId)
        {
            errorMessage = "Du kan ikke slette din egen bruger.";
            confirmDeleteUserId = null;
            return;
        }

        isProcessingDelete = true;

        try
        {
            var deleted = await UserService.DeleteAsync(user.Id);
            statusMessage = deleted
                ? $"Brugeren {user.Username} blev slettet."
                : $"Brugeren {user.Username} blev ikke fundet.";

            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunne ikke slette brugeren: {ex.Message}";
        }
        finally
        {
            isProcessingDelete = false;
            confirmDeleteUserId = null;
        }
    }

    private static bool IsValidPassword(string password)
    {
        return password.Length >= 8
            && password.Any(char.IsUpper)
            && password.Any(char.IsDigit)
            && password.Any(c => !char.IsLetterOrDigit(c));
    }

    // OPDATERET (FASE 3): Gemmer nu til databasen
    private async Task HandleSave()
    {
        isProcessingSave = true;

        try
        {
            if (isCreatingNewUser)
            {
                // Hash adgangskoden (vigtigt!)
                currentUser.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPassword);
                await UserService.AddAsync(currentUser);
            }
            else
            {
                // Opdater kun rolle (PasswordHash er uændret)
                await UserService.UpdateAsync(currentUser);
            }

            // Genindlæs listen fra databasen
            await LoadUsers();
            CloseModal();
        }
        catch (Exception ex)
        {
            // Håndter fejl (f.eks. "Brugernavn findes allerede")
            Console.WriteLine(ex.Message);
            // I en rigtig app ville vi vise fejlen i modalen
        }
        finally
        {
            isProcessingSave = false;
        }
    }

    // --- START: Logik fra DataTest.razor (TILFØJET FASE 3) ---
    private List<(string Status, string Error)> testLog = new();
    private bool isProcessingTest = false;

    private async Task RunDataTest()
    {
        isProcessingTest = true;
        testLog.Clear();
        var sw = new Stopwatch();

        // Test UserService (vi har allerede loaded)
        testLog.Add(($"OK - Hentede {usersList.Count()} brugere (allerede indlæst).", ""));

        // Test ConcertService
        try
        {
            sw.Start();
            var concerts = await ConcertService.GetUpcomingConcertsAsync();
            sw.Stop();
            testLog.Add(($"OK - Hentede {concerts.Count()} koncerter på {sw.ElapsedMilliseconds} ms.", ""));
        }
        catch (Exception ex) { testLog.Add(("FEJL (ConcertService)", ex.Message)); }
        finally { sw.Reset(); }

        // Test ProductService
        try
        {
            sw.Start();
            var groups = await ProductService.GetAllGroupsWithVariantsAsync();
            sw.Stop();
            testLog.Add(($"OK - Hentede {groups.Count()} produktgrupper på {sw.ElapsedMilliseconds} ms.", ""));
        }
        catch (Exception ex) { testLog.Add(("FEJL (ProductService)", ex.Message)); }
        finally { sw.Reset(); }

        // Test CalendarEventService
        try
        {
            sw.Start();
            var events = await CalendarEventService.GetEventsForPeriodAsync(DateTime.UtcNow.AddYears(-5), DateTime.UtcNow.AddYears(5));
            sw.Stop();
            testLog.Add(($"OK - Hentede {events.Count()} events på {sw.ElapsedMilliseconds} ms.", ""));
        }
        catch (Exception ex) { testLog.Add(("FEJL (CalendarEventService)", ex.Message)); }
        finally { sw.Reset(); }

        isProcessingTest = false;
    }
    // --- SLUT: Logik fra DataTest.razor ---
}
