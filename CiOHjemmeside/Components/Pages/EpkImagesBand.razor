@page "/epk/images/band"
@layout Layout.MainLayout
@rendermode InteractiveServer

<PageTitle>EPK - Band Pictures</PageTitle>

<EpkGate>
    <div class="epk">
        <EpkHeader Title="Band pictures" ParentTitle="Images" ParentHref="/epk/images"
                   Lead="Press photos in full resolution. Free to use for promotion of Cursed Into Oblivion." />

        <EpkAssetManager Category="@EpkCategories.ImagesBand" Gallery="true" />

        <a class="epk-back" href="/epk/images">&#8592; Back to images</a>
    </div>
</EpkGate>
