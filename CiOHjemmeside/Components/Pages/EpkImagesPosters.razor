@page "/epk/images/posters"
@layout Layout.MainLayout
@rendermode InteractiveServer

<PageTitle>EPK - Logos &amp; Posters</PageTitle>

<EpkGate>
    <div class="epk">
        <EpkHeader Title="Logos & posters" ParentTitle="Images" ParentHref="/epk/images"
                   Lead="Logos and artwork for posters and flyers. Use the dots on each image to preview it on a dark, light, red or transparent background." />

        <EpkAssetManager Category="@EpkCategories.ImagesPosters" Gallery="true" />

        <a class="epk-back" href="/epk/images">&#8592; Back to images</a>
    </div>
</EpkGate>
