@page "/epk"
@layout Layout.MainLayout
@rendermode InteractiveServer
@inject IEpkAccessService EpkAccessService

<PageTitle>EPK - Cursed Into Oblivion</PageTitle>

<div class="epk">
    @if (!isAccessGranted)
    {
        <p class="epk-kicker">Electronic Press Kit</p>
        <h1 class="epk-title">Press access</h1>
        <div class="epk-rule"></div>
        <p class="epk-lead">For promoters, venues and press. Enter the access code you received from the band.</p>

        <div class="epk-frame epk-lock">
            <form class="epk-form" @onsubmit="UnlockEpk" @onsubmit:preventDefault>
                <input class="epk-input epk-code-input" type="password" @bind="accessCode"
                       placeholder="Access code" autocomplete="off" aria-label="Access code" />
                <button type="submit" class="epk-btn epk-btn-primary epk-unlock-button">
                    Unlock <span class="epk-arrow">&#8594;</span>
                </button>
            </form>
            @if (!string.IsNullOrWhiteSpace(accessError))
            {
                <p class="epk-error">@accessError</p>
            }
            <p class="epk-contact">
                Need access? <a href="mailto:Cursedintooblivion00@gmail.com">Cursedintooblivion00@gmail.com</a>
            </p>
        </div>
    }
    else
    {
        <p class="epk-kicker">Cursed Into Oblivion</p>
        <h1 class="epk-title">Electronic Press Kit</h1>
        <div class="epk-rule"></div>
        <p class="epk-lead">Everything promoters, venues and press need – riders, press texts, photos and logos.</p>

        <div class="epk-frame">
            @foreach (var (section, index) in sections.Select((s, i) => (s, i)))
            {
                <a class="epk-row epk-row-link" href="@section.Href">
                    <span class="epk-row-index">@((index + 1).ToString("00"))</span>
                    <span>
                        <span class="epk-row-title">@section.Title</span>
                        <span class="epk-row-meta">@section.Description</span>
                    </span>
                    <span class="epk-row-actions">
                        <span class="epk-btn epk-btn-outline">Open <span class="epk-arrow">&#8594;</span></span>
                    </span>
                </a>
            }
        </div>
    }
</div>

@code {
    // Saettes af EpkGate, naar en underside sender en bruger uden adgang hertil.
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Inject]
    private NavigationManager NavManager { get; set; } = default!;

    private static readonly (string Title, string Description, string Href)[] sections =
    {
        ("Riders", "Technical + hospitality rider", "/epk/riders"),
        ("Press", "Press text in English and Danish", "/epk/press"),
        ("Images", "Band photos, logos and poster artwork", "/epk/images")
    };

    private bool isAccessGranted;
    private string accessCode = string.Empty;
    private string accessError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isAccessGranted = await EpkAccessService.HasAccessAsync();

        if (isAccessGranted)
        {
            GoToReturnUrl();
        }
    }

    private async Task UnlockEpk()
    {
        accessError = string.Empty;

        var unlocked = await EpkAccessService.ValidateAndUnlockAsync(accessCode);
        if (unlocked)
        {
            isAccessGranted = true;
            GoToReturnUrl();
            return;
        }

        accessError = "Invalid access code.";
    }

    private void GoToReturnUrl()
    {
        // Kun lokale EPK-stier, saa returnUrl ikke kan bruges til at sende folk til andre sider.
        if (!string.IsNullOrEmpty(ReturnUrl)
            && ReturnUrl.StartsWith("/epk/", StringComparison.OrdinalIgnoreCase)
            && !ReturnUrl.Contains("//")
            && !ReturnUrl.Contains('\\'))
        {
            NavManager.NavigateTo(ReturnUrl, replace: true);
        }
    }
}
