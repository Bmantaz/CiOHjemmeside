@page "/sales"
@layout Layout.InternalLayout
@rendermode InteractiveServer

@inject ISalesService SalesService
@inject IConcertService ConcertService
@inject NavigationManager NavManager
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime JS
@implements IDisposable
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Claims

<PageTitle>Sales Dashboard</PageTitle>

<div class="pos-container">
    <div class="product-grid">
        @if (productGroups == null)
        {
            <div class="loading-state">
                <p>Indlæser produkter fra databasen...</p>
            </div>
        }
        else if (!productGroups.Any())
        {
            <div class="alert alert-warning">
                <h5>Ingen produkter fundet!</h5>
                <p>Databasen er tom. Kør Database Seeder for at oprette 'Basic-T' og 'Patches'.</p>
            </div>
        }
        else
        {
            @foreach (var group in productGroups)
            {
                var inStock = group.Variants.Sum(v => v.StockQuantity);
                <div class="product-card @(inStock <= 0 ? "sold-out" : "")" @onclick="() => SelectProductGroup(group)">
                    <div class="product-media">
                        @if (!string.IsNullOrEmpty(group.ImageUrl))
                        {
                            <img src="@group.ImageUrl" alt="@group.GroupName" />
                        }
                        else
                        {
                            <span class="product-media-empty">CIO</span>
                        }
                        @if (inStock <= 0)
                        {
                            <span class="product-badge">Udsolgt</span>
                        }
                    </div>
                    <div class="product-info">
                        <span class="product-name">@group.GroupName</span>
                        <span class="product-meta">@PriceLabel(group) &middot; @inStock på lager</span>
                    </div>
                </div>
            }
        }
    </div>

    <div class="cart-section">
        <p class="pos-kicker">Merch stand</p>
        <h3 class="pos-title">Kurv</h3>
        <div class="pos-rule"></div>

        <div class="seller-indicator">
            <span class="seller-current">
                <span class="pos-label">Aktiv sælger</span>
                <strong>@(string.IsNullOrWhiteSpace(selectedRecipientName) ? "Ingen valgt" : selectedRecipientName)</strong>
            </span>
            <button type="button" class="btn-switch-seller" @onclick="OpenSellerSelection">Skift</button>
        </div>

        <div class="show-picker">
            <label class="pos-label" for="show-select">Show / spillested</label>
            <select id="show-select" class="form-select" @bind="selectedConcertId">
                <option value="">Ukendt / ikke et show</option>
                @foreach (var concert in concerts)
                {
                    <option value="@concert.Id">
                        @concert.EventDate.ToString("dd-MM-yyyy") - @concert.VenueName@(string.IsNullOrWhiteSpace(concert.City) ? "" : $", {concert.City}")
                    </option>
                }
            </select>
        </div>

        @if (!cart.Any())
        {
            <div class="cart-empty">Kurven er tom</div>
        }
        else
        {
            <div class="cart-items">
                @foreach (var item in cart)
                {
                    <div class="cart-item">
                        <span class="cart-item-size">@item.Variant.VariantName</span>
                        <span class="cart-item-name">@item.Group.GroupName</span>
                        <span class="cart-item-price">@FormatKr(item.Variant.Price ?? 0m)</span>
                        <button class="btn-remove-item" @onclick="() => RemoveFromCart(item)" aria-label="Fjern @item.Group.GroupName @item.Variant.VariantName">×</button>
                    </div>
                }
            </div>
            <div class="cart-total">
                <span class="pos-label">Total &middot; @cart.Count stk.</span>
                <span class="cart-total-amount">@FormatKr(GetCartTotal())</span>
            </div>
        }

        @{ var canPay = cart.Any() && !string.IsNullOrWhiteSpace(selectedRecipientName); }
        <div class="pay-buttons">
            <button class="btn-pay btn-pay-mobilepay" @onclick="OpenCustomerScreen" disabled="@(!canPay)">
                MobilePay
                <span class="btn-pay-sub">Vend skærmen til kunden</span>
            </button>
            <button class="btn-pay btn-pay-cash" @onclick="OpenCashModal" disabled="@(!canPay)">
                Kontant
            </button>
        </div>

        @if (!string.IsNullOrEmpty(saleStatusMessage))
        {
            <p class="pos-status pos-status-ok">@saleStatusMessage</p>
        }
        @if (!string.IsNullOrEmpty(saleErrorMessage))
        {
            <p class="pos-status pos-status-error">@saleErrorMessage</p>
        }
    </div>
</div>

@if (isSellerSelectionVisible)
{
    var hasSeller = !string.IsNullOrWhiteSpace(selectedRecipientName);
    @* Første gang SKAL der vælges en sælger; derefter kan man lukke vælgeren igen. *@
    <div class="modal-backdrop" @onclick="() => { if (hasSeller) isSellerSelectionVisible = false; }"></div>
    <div class="modal-content seller-modal">
        <div class="modal-header">
            <div>
                <p class="pos-kicker">Merch stand</p>
                <h3>@(hasSeller ? "Skift sælger" : "Åbn shop")</h3>
            </div>
            @if (hasSeller)
            {
                <button class="btn-close-modal" @onclick="() => isSellerSelectionVisible = false" aria-label="Luk">×</button>
            }
        </div>
        <div class="modal-body">
            <p class="modal-lead">Hvem står bag disken nu? Salg registreres på denne person, og MobilePay går til deres nummer.</p>
            <div class="seller-grid">
                @foreach (var recipient in mobilePayRecipients)
                {
                    <button class="btn-seller-select @(recipient.Name == selectedRecipientName ? "active" : "")"
                            @onclick="() => SelectSellerAndOpenShop(recipient.Name)">
                        @recipient.Name
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (selectedGroup != null)
{
    <div class="modal-backdrop" @onclick="CloseVariantModal"></div>
    <div class="modal-content variant-modal">
        <div class="modal-header">
            <div>
                <p class="pos-kicker">Vælg størrelse</p>
                <h3>@selectedGroup.GroupName</h3>
            </div>
            <button class="btn-close-modal" @onclick="CloseVariantModal" aria-label="Luk">×</button>
        </div>
        <div class="modal-body variant-grid">
            @foreach (var variant in ProductSizeOrder.Sort(selectedGroup.Variants))
            {
                var soldOut = variant.StockQuantity <= 0;
                var inCart = cart.Count(c => c.Variant == variant);
                <button class="btn-variant @(soldOut ? "disabled" : "") @(inCart > 0 ? "in-cart" : "")"
                        @onclick="() => AddToCart(selectedGroup, variant)"
                        disabled="@soldOut">
                    @if (inCart > 0)
                    {
                        <span class="variant-count">@inCart</span>
                    }
                    <span class="variant-name">@variant.VariantName</span>
                    <span class="variant-stock">@(soldOut ? "Udsolgt" : $"{variant.StockQuantity} på lager")</span>
                </button>
            }
        </div>
        <div class="modal-footer-bar">
            <span class="pos-label">@cart.Count stk. i kurven &middot; @FormatKr(GetCartTotal())</span>
            <button class="btn-modal-done" @onclick="CloseVariantModal">Færdig</button>
        </div>
    </div>
}

@* ---------- Kontant: vendt mod sælgeren, med byttepenge-beregner ---------- *@
@if (isPaymentModalVisible)
{
    <div class="modal-backdrop" @onclick="ClosePaymentModal"></div>
    <div class="modal-content payment-modal">
        <div class="modal-header">
            <div>
                <p class="pos-kicker">Betaling</p>
                <h3>Kontant</h3>
            </div>
            <button class="btn-close-modal" @onclick="ClosePaymentModal" aria-label="Luk">×</button>
        </div>
        <div class="modal-body text-center">
            <span class="pos-label">At betale</span>
            <div class="cash-total">@FormatKr(GetCartTotal())</div>
            <p class="cash-seller">Sælger: <strong>@selectedRecipientName</strong></p>

            <div class="cash-box">
                <label class="pos-label" for="cashReceived">Modtaget (kr.)</label>
                <input id="cashReceived" class="cash-input" type="number" inputmode="numeric" min="0" step="1"
                       @bind="cashReceivedInput" @bind:event="oninput" />
                <div class="cash-quick">
                    @foreach (var amount in GetQuickCashAmounts())
                    {
                        <button type="button" class="btn-cash-quick" @onclick="() => cashReceivedInput = amount.ToString()">@amount kr.</button>
                    }
                </div>
                <p class="cash-change">Byttepenge: <strong>@FormatKr(GetCashChange())</strong></p>
                @if (!string.IsNullOrWhiteSpace(cashReceivedInput) && !IsCashPaymentValid())
                {
                    <p class="text-danger small">Beløbet er mindre end totalen.</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(saleErrorMessage))
            {
                <p class="text-danger">@saleErrorMessage</p>
            }

            <button class="btn-complete-sale" @onclick="CompleteSale" disabled="@(isCompletingSale || !CanCompletePayment())">
                @(isCompletingSale ? "Gemmer..." : "Bekræft kontant salg")
            </button>
        </div>
    </div>
}

@* ---------- MobilePay: fuldskærm vendt mod kunden ---------- *@
@if (isCustomerScreenVisible)
{
    var recipient = mobilePayRecipients.FirstOrDefault(r => r.Name == selectedRecipientName);
    <div class="customer-screen" role="dialog" aria-label="MobilePay betaling">
        <div class="cs-main">
            <div class="cs-brand">MobilePay</div>

            <div class="cs-label">Beløb &middot; Amount</div>
            <div class="cs-amount">@FormatKr(GetCartTotal())</div>

            <div class="cs-label">Send til &middot; Send to</div>
            <div class="cs-phone">@(recipient?.PhoneNumber ?? "—")</div>
            <div class="cs-name">@selectedRecipientName</div>

            <ul class="cs-items">
                @foreach (var line in GetCartLines())
                {
                    <li>@line</li>
                }
            </ul>
        </div>

        <div class="cs-seller-bar">
            <button type="button" class="cs-back" @onclick="CloseCustomerScreen" disabled="@isCompletingSale">&larr; Tilbage</button>

            <div class="cs-seller-right">
                @if (!string.IsNullOrEmpty(saleErrorMessage))
                {
                    <span class="cs-error">@saleErrorMessage</span>
                }
                else
                {
                    <span class="cs-hint">Sælger: hold knappen inde, når du har set betalingen</span>
                }

                <button type="button"
                        class="cs-hold @(isHolding ? "holding" : "")"
                        disabled="@isCompletingSale"
                        @onpointerdown="StartHoldToConfirm"
                        @onpointerup="CancelHoldToConfirm"
                        @onpointerleave="CancelHoldToConfirm"
                        @onpointercancel="CancelHoldToConfirm"
                        @oncontextmenu:preventDefault>
                    <span class="cs-hold-fill" style="--hold-ms: @(HoldToConfirmMs)ms"></span>
                    <span class="cs-hold-text">@(isCompletingSale ? "Gemmer..." : isHolding ? "Bliv ved..." : "Hold for at bekræfte salg")</span>
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Kvittering: tydelig bekræftelse, lukker selv ---------- *@
@if (confirmedSale is not null)
{
    <div class="sale-confirmed" @onclick="DismissConfirmation">
        <div class="sale-confirmed-check">&#10003;</div>
        <div class="sale-confirmed-title">Betalt</div>
        <div class="sale-confirmed-amount">@FormatKr(confirmedSale.Amount)</div>
        <div class="sale-confirmed-sub">Tak for købet! &middot; Thank you!</div>
        <div class="sale-confirmed-meta">@confirmedSale.Method &middot; registreret på @confirmedSale.Seller</div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ProductGroup> productGroups = null;
    private List<(ProductGroup Group, ProductVariant Variant)> cart = new();
    private ProductGroup? selectedGroup;
    private bool isPaymentModalVisible = false;
    private bool isCompletingSale = false;
    private int _currentUserId;
    private string saleStatusMessage = string.Empty;
    private string saleErrorMessage = string.Empty;
    private string selectedRecipientName = string.Empty;
    private bool isSellerSelectionVisible = false;
    private string selectedPaymentMethod = "MobilePay";
    private string cashReceivedInput = string.Empty;
    private List<Concert> concerts = new();
    private int? selectedConcertId;

    private readonly List<MobilePayRecipient> mobilePayRecipients = new()
    {
        new("Sebastian", "42 23 80 30"),
        new("Henrik", "53 68 86 76"),
        new("Kristofer", "21 66 48 20"),
        new("Bjarke", "27 52 90 51")
    };
     
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        var userIdClaim = user.FindFirstValue(ClaimTypes.NameIdentifier);
        _currentUserId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;

        await LoadSellerSelectionAsync();
        await LoadProductsAsync();
        await LoadConcertsAsync();
    }

    private async Task LoadConcertsAsync()
    {
        try
        {
            concerts = (await ConcertService.GetAllConcertsAsync()).ToList();

            // Forvalg et show der ligger i dag, saa saelgeren normalt ikke skal roere dropdownen.
            var today = DateTime.Today;
            selectedConcertId = concerts
                .FirstOrDefault(c => c.EventDate.Date == today)?.Id;
        }
        catch (Exception ex)
        {
            saleErrorMessage = $"Kunne ikke hente shows: {ex.Message}";
        }
    }

    private async Task LoadProductsAsync()
    {
        try { productGroups = await SalesService.GetAllProductGroupsWithVariantsAsync(); }
        catch (Exception ex) { saleErrorMessage = $"Fejl ved indlæsning: {ex.Message}"; productGroups = new(); }
    }

    private async Task LoadSellerSelectionAsync()
    {
        try
        {
            var res = await SessionStorage.GetAsync<string>("CiO-ActiveSeller");

            // Kun gyldige sælgere; en gemt sælger der ikke længere er i bandet skal vælges om.
            if (res.Success && mobilePayRecipients.Any(r => r.Name == res.Value))
            {
                selectedRecipientName = res.Value!;
                isSellerSelectionVisible = false;
            }
            else
            {
                selectedRecipientName = string.Empty;
                isSellerSelectionVisible = true;
            }
        }
        catch { isSellerSelectionVisible = true; }
    }

    private void OpenSellerSelection() => isSellerSelectionVisible = true;

    private async Task SelectSellerAndOpenShop(string name)
    {
        var changed = !string.IsNullOrWhiteSpace(selectedRecipientName) && selectedRecipientName != name;
        selectedRecipientName = name;
        isSellerSelectionVisible = false;

        if (changed)
        {
            saleErrorMessage = string.Empty;
            saleStatusMessage = $"Aktiv sælger er nu {name}.";
        }

        await SessionStorage.SetAsync("CiO-ActiveSeller", name);
    }

    private void SelectProductGroup(ProductGroup group) => selectedGroup = group;
    private void CloseVariantModal() => selectedGroup = null;

    private void AddToCart(ProductGroup group, ProductVariant variant)
    {
        if (variant.StockQuantity > 0)
        {
            variant.StockQuantity--;
            cart.Add((group, variant));
            saleStatusMessage = string.Empty;
        }
    }

    private void RemoveFromCart((ProductGroup Group, ProductVariant Variant) item)
    {
        item.Variant.StockQuantity++;
        cart.Remove(item);
    }

    // ---------- Betaling ----------

    // Hvor længe sælgeren skal holde "bekræft" inde på kundeskærmen. Et hurtigt
    // (fuldt) kundetryk bekræfter derfor aldrig et salg ved et uheld.
    private const int HoldToConfirmMs = 1500;

    private static readonly System.Globalization.CultureInfo Danish = new("da-DK");

    private bool isCustomerScreenVisible;
    private bool isHolding;
    private CancellationTokenSource? holdCts;
    private ConfirmedSale? confirmedSale;
    private CancellationTokenSource? confirmationCts;

    private void OpenCustomerScreen()
    {
        saleStatusMessage = string.Empty;
        saleErrorMessage = string.Empty;
        selectedPaymentMethod = "MobilePay";
        isCustomerScreenVisible = true;
    }

    private void CloseCustomerScreen()
    {
        CancelHoldToConfirm();
        saleErrorMessage = string.Empty;
        isCustomerScreenVisible = false;
    }

    private void OpenCashModal()
    {
        saleStatusMessage = string.Empty;
        saleErrorMessage = string.Empty;
        selectedPaymentMethod = "Cash";
        cashReceivedInput = string.Empty;
        isPaymentModalVisible = true;
    }

    private void ClosePaymentModal() => isPaymentModalVisible = false;

    private async Task StartHoldToConfirm()
    {
        if (isCompletingSale || isHolding) return;

        isHolding = true;
        holdCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(HoldToConfirmMs, holdCts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // Sluppet for tidligt.
        }

        isHolding = false;
        await CompleteSale();
    }

    private void CancelHoldToConfirm()
    {
        holdCts?.Cancel();
        isHolding = false;
    }

    private void DismissConfirmation()
    {
        confirmationCts?.Cancel();
        confirmedSale = null;
    }

    private async Task ShowConfirmationAsync(ConfirmedSale sale)
    {
        confirmationCts?.Cancel();
        confirmationCts = new CancellationTokenSource();
        var token = confirmationCts.Token;
        confirmedSale = sale;

        try
        {
            await Task.Delay(3000, token);
            confirmedSale = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Lukket manuelt eller nyt salg.
        }
    }

    private async Task CompleteSale()
    {
        if (!cart.Any() || _currentUserId <= 0 || isCompletingSale) return;

        isCompletingSale = true;
        saleErrorMessage = string.Empty;
        var amount = GetCartTotal();
        var method = selectedPaymentMethod == "Cash" ? "Kontant" : "MobilePay";

        try
        {
            var saleItems = cart
                .GroupBy(item => new { item.Group.GroupName, item.Variant.VariantName, Price = item.Variant.Price ?? 0 })
                .Select(g => new SaleItemInput
                {
                    ProductGroupName = g.Key.GroupName,
                    VariantName = g.Key.VariantName,
                    Quantity = g.Count(),
                    UnitPrice = g.Key.Price
                })
                .ToList();

            await SalesService.RecordSaleAsync(_currentUserId, saleItems, null, selectedConcertId, selectedRecipientName);

            saleStatusMessage = $"Salg gennemført – {FormatKr(amount)} registreret på {selectedRecipientName}.";
            cart.Clear();
            isPaymentModalVisible = false;
            isCustomerScreenVisible = false;
            await LoadProductsAsync(); // Opdater lageret i UI fra DB
        }
        catch (Exception ex)
        {
            saleErrorMessage = $"Salget blev IKKE gemt: {ex.Message}";
            return;
        }
        finally
        {
            isCompletingSale = false;
        }

        // Vises efter finally, så knapperne allerede er låst op bag kvitteringen.
        _ = ShowConfirmationAsync(new ConfirmedSale(amount, method, selectedRecipientName));
    }

    private decimal GetCartTotal() => cart.Sum(i => i.Variant.Price ?? 0m);

    /// <summary>"200 kr." – eller "fra 125 kr." hvis størrelserne har forskellige priser.</summary>
    private static string PriceLabel(ProductGroup group)
    {
        var prices = group.Variants.Where(v => v.Price.HasValue).Select(v => v.Price!.Value).Distinct().ToList();
        if (!prices.Any()) return "Ingen pris";
        return prices.Count == 1 ? FormatKr(prices[0]) : $"fra {FormatKr(prices.Min())}";
    }

    private static string FormatKr(decimal amount) =>
        (amount % 1 == 0 ? amount.ToString("N0", Danish) : amount.ToString("N2", Danish)) + " kr.";

    /// <summary>Kurven samlet til linjer som "2 × Spear Logo T (SORT) · L" til kundeskærmen.</summary>
    private IEnumerable<string> GetCartLines() =>
        cart.GroupBy(i => (i.Group.GroupName, i.Variant.VariantName))
            .Select(g => $"{g.Count()} × {g.Key.GroupName} · {g.Key.VariantName}");

    /// <summary>Typiske sedler/beløb kunden betaler med, fx 200 → 200, 250, 300, 500.</summary>
    private IEnumerable<int> GetQuickCashAmounts()
    {
        var total = (int)Math.Ceiling(GetCartTotal());
        return new[] { total, RoundUp(total, 50), RoundUp(total, 100), RoundUp(total, 500) }
            .Where(a => a > 0)
            .Distinct()
            .Take(4);

        static int RoundUp(int value, int step) => (value + step - 1) / step * step;
    }

    // Tomt felt er OK (sælgeren har bare talt pengene); udfyldt skal det dække totalen.
    private bool IsCashPaymentValid()
    {
        if (selectedPaymentMethod != "Cash" || string.IsNullOrWhiteSpace(cashReceivedInput)) return true;
        return decimal.TryParse(cashReceivedInput, out var received) && received >= GetCartTotal();
    }

    private decimal GetCashChange()
    {
        if (!decimal.TryParse(cashReceivedInput, out var received)) return 0m;
        var change = received - GetCartTotal();
        return change < 0 ? 0m : change;
    }

    private bool CanCompletePayment() => !string.IsNullOrWhiteSpace(selectedRecipientName) && (selectedPaymentMethod == "MobilePay" || IsCashPaymentValid());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Hold iPad'en vågen mens salgssiden er åben (Safari 16.4+). Fejler stille ellers.
            try { await JS.InvokeVoidAsync("cioSales.keepAwake"); } catch { }
        }
    }

    public void Dispose()
    {
        holdCts?.Cancel();
        confirmationCts?.Cancel();
    }

    private sealed record MobilePayRecipient(string Name, string PhoneNumber);

    private sealed record ConfirmedSale(decimal Amount, string Method, string Seller);
}