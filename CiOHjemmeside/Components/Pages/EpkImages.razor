@page "/epk/images"
@layout Layout.MainLayout
@rendermode InteractiveServer

<PageTitle>EPK - Images</PageTitle>

<EpkGate>
    <div class="epk">
        <EpkHeader Title="Images" Lead="High-resolution band photos and logo / poster artwork." />

        <div class="epk-frame">
            <a class="epk-row epk-row-link" href="/epk/images/band">
                <span class="epk-row-index">01</span>
                <span>
                    <span class="epk-row-title">Band pictures</span>
                    <span class="epk-row-meta">Press photos, with and without logo</span>
                </span>
                <span class="epk-row-actions">
                    <span class="epk-btn epk-btn-outline">Open <span class="epk-arrow">&#8594;</span></span>
                </span>
            </a>
            <a class="epk-row epk-row-link" href="/epk/images/posters">
                <span class="epk-row-index">02</span>
                <span>
                    <span class="epk-row-title">Logos &amp; posters</span>
                    <span class="epk-row-meta">Headers, stacked logos and spear marks</span>
                </span>
                <span class="epk-row-actions">
                    <span class="epk-btn epk-btn-outline">Open <span class="epk-arrow">&#8594;</span></span>
                </span>
            </a>
        </div>

        <a class="epk-back" href="/epk">&#8592; Back to press kit</a>
    </div>
</EpkGate>
